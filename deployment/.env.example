# Copy to `.env` on the server. Not in git: this is the one file that differs
# between machines. CI never overwrites it, only its TAG line.

# Port the host's nginx proxies into. Bound to 127.0.0.1 by compose.
APP_PORT=8080

# The Spring config with the production settings and secrets, see
# application.example.yml. Relative paths are relative to this directory.
CONFIG_PATH=./application.yml

# The backend runs as this user, and it has to be able to read the config.
# Set to the deploy user's ids: `id -u deploy`, `id -g deploy`.
APP_UID=1000
APP_GID=1000

# Which build is running. CI overwrites this on deploy; setting it by hand to
# an older commit is how a rollback works.
TAG=latest
